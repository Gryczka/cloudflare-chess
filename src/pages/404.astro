---
import BackgroundLines from '../components/BackgroundLines.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
	<BackgroundLines />
	<Header />
	<main id="main-content" class="not-found">
		<Card class="not-found__card">
			<img src="/img/404.png" alt="A fallen chess knight" />
			<p class="eyebrow">404</p>
			<h1>Page not found.</h1>
			<p>We couldn't find that page. Check the URL or head back to matchmaking.</p>
			<Button href="/play">Find a match</Button>
		</Card>
	</main>
	<Footer />
</Layout>

<style>
	.not-found {
		display: grid;
		place-items: center;
		min-height: calc(100vh - 84px);
		padding: 48px 16px;
	}

	.not-found__card {
		max-width: 540px;
		padding: 32px;
		text-align: center;
	}

	img {
		width: 180px;
		border-radius: 18px;
	}

	.eyebrow {
		margin: 24px 0 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cf-orange);
	}

	h1 {
		margin: 0;
		font-size: 44px;
		line-height: 1;
		font-weight: 500;
		letter-spacing: -0.04em;
	}

	p:last-of-type {
		margin: 16px 0 24px;
		color: var(--cf-text-muted);
		line-height: 1.55;
	}
</style>
