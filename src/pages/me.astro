---
import { env } from 'cloudflare:workers';
import BackgroundLines from '../components/BackgroundLines.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { resolvePlayerId } from '../lib/identity';

export const prerender = false;

const playerId = await resolvePlayerId(Astro.request, env.AUTH_SECRET);
const bundle = playerId ? await env.MATCHMAKER.getByName('global').getProfileBundle(playerId, 30) : null;
const profile = bundle?.profile;
const recent = bundle?.recent ?? [];
const winRate = profile?.games ? Math.round((profile.wins / profile.games) * 100) : 0;
---

<Layout title="Your Chess Profile">
	<BackgroundLines />
	<Header />
	<main id="main-content" class="profile-page">
		{profile ? (
			<>
				<Card class="profile-hero">
					<div>
						<p class="eyebrow">Your profile</p>
						<h1>{profile?.username ?? playerId}</h1>
						<p>{profile.username} · {profile.isProvisional ? 'Provisional rating' : 'Established rating'}</p>
					</div>
					<div class="rating-block">
						<span>Rating</span>
						<strong>{profile.rating}</strong>
						<small>Peak {profile.peakRating}</small>
					</div>
				</Card>
				<div class="profile-grid">
					<Card class="profile-card stats-card">
						<h2>Record</h2>
						<div class="stats-row"><strong>{profile.games}</strong><span>Rated games</span></div>
						<div class="stats-row"><strong>{profile.wins}-{profile.losses}-{profile.draws}</strong><span>W-L-D</span></div>
						<div class="stats-row"><strong>{winRate}%</strong><span>Win rate</span></div>
						{(profile.bulletRating || profile.blitzRating || profile.rapidRating) && (
							<>
								{profile.bulletRating && <div class="stats-row"><strong>{profile.bulletRating}</strong><span>Bullet Elo</span></div>}
								{profile.blitzRating && <div class="stats-row"><strong>{profile.blitzRating}</strong><span>Blitz Elo</span></div>}
								{profile.rapidRating && <div class="stats-row"><strong>{profile.rapidRating}</strong><span>Rapid Elo</span></div>}
							</>
						)}
					</Card>
					<Card class="profile-card stats-card">
						<h2>Bot games</h2>
						<div class="stats-row"><strong>{profile.botGames}</strong><span>Total</span></div>
						<div class="stats-row"><strong>{profile.botWins}-{profile.botLosses}-{profile.botDraws}</strong><span>W-L-D</span></div>
						<p class="muted">Bot games never affect Elo.</p>
					</Card>
					<Card class="profile-card id-card">
						<h2>Save your ID</h2>
						<p class="muted">Use this on another device to keep your rating.</p>
						<code>{profile.playerId}</code>
						<div class="button-row">
							<button data-copy-id={profile.playerId}>Copy ID</button>
							<button data-download-id={profile.playerId}>Download .txt</button>
						</div>
					</Card>
				</div>
				<Card class="profile-card history-card">
					<h2>Recent results</h2>
					{recent.length ? (
						<table>
							<thead><tr><th>Opponent</th><th>Result</th><th>Rating</th><th>Delta</th></tr></thead>
							<tbody>
								{recent.map((entry) => (
									<tr>
										<td>{entry.opponentId}</td>
										<td>{entry.result}{entry.isBot ? ' · bot' : ''}</td>
										<td>{entry.rating}</td>
										<td class:list={[entry.delta > 0 && 'good', entry.delta < 0 && 'bad']}>{entry.delta > 0 ? `+${entry.delta}` : entry.delta}</td>
									</tr>
								))}
							</tbody>
						</table>
					) : <p class="muted">No rated games yet.</p>}
				</Card>
			</>
		) : (
			<Card class="profile-hero empty-profile">
				<p class="eyebrow">No player ID</p>
				<h1>No profile yet.</h1>
				<p>Play a match to mint your chess ID and start tracking Elo.</p>
				<Button href="/play">Find a match</Button>
			</Card>
		)}
	</main>
	<Footer />
	<script is:inline>
		document.querySelectorAll('[data-copy-id]').forEach((button) => {
			button.addEventListener('click', async () => {
				await navigator.clipboard.writeText(button.getAttribute('data-copy-id'));
				button.textContent = 'Copied';
				setTimeout(() => (button.textContent = 'Copy ID'), 1400);
			});
		});
		document.querySelector('[data-download-id]')?.addEventListener('click', (event) => {
			const id = event.currentTarget.getAttribute('data-download-id');
			const blob = new Blob([`Cloudflare Chess player ID\n${id}\n`], { type: 'text/plain' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = 'cloudflare-chess-player-id.txt';
			a.click();
			URL.revokeObjectURL(url);
		});
	</script>
</Layout>

<style>
	.profile-page { max-width: var(--container-xl); margin: 0 auto; padding: 48px 16px 0; }
	:global(.profile-hero) { display: flex; justify-content: space-between; gap: 24px; padding: 36px; align-items: end; }
	.eyebrow { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--cf-orange); }
	h1 { margin: 0; font-size: clamp(34px, 6vw, 64px); line-height: 1; font-weight: 500; letter-spacing: -.05em; }
	p { color: var(--cf-text-muted); line-height: 1.55; }
	.rating-block { display: grid; gap: 2px; text-align: right; font-family: var(--font-mono); }
	.rating-block span, .rating-block small { color: var(--cf-text-muted); font-size: 12px; }
	.rating-block strong { color: var(--cf-orange); font-size: 54px; font-weight: 500; line-height: 1; }
	.profile-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
	:global(.profile-card) { padding: 24px; }
	h2 { margin: 0 0 16px; font-size: 22px; font-weight: 500; letter-spacing: -.03em; }
	.stats-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--cf-border-light); }
	.stats-row strong { font-family: var(--font-mono); font-size: 24px; font-weight: 500; }
	.stats-row span, .muted { color: var(--cf-text-muted); }
	.id-card code { display: block; padding: 12px; border-radius: 10px; background: var(--cf-bg-100); font-family: var(--font-mono); color: var(--cf-orange); overflow: auto; }
	.button-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
	button { min-height: 40px; padding: 0 14px; border: 1px solid var(--cf-border); border-radius: 9999px; background: var(--cf-bg-100); color: var(--cf-text); cursor: pointer; }
	.history-card { margin-top: 16px; }
	table { width: 100%; border-collapse: collapse; font-size: 14px; }
	th, td { padding: 12px 8px; border-top: 1px solid var(--cf-border-light); text-align: left; }
	th { color: var(--cf-text-muted); font-weight: 500; }
	.good { color: var(--cf-success); }
	.bad { color: var(--cf-error); }
	@media (max-width: 840px) { :global(.profile-hero), .profile-grid { display: grid; grid-template-columns: 1fr; } .rating-block { text-align: left; } }
</style>
