---
import { env } from 'cloudflare:workers';
import BackgroundLines from '../components/BackgroundLines.astro';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const sort = Astro.url.searchParams.get('sort') === 'games' ? 'games' : 'rating';
const entries = await env.MATCHMAKER.getByName('global').getLeaderboard(50, sort);
---

<Layout title="Cloudflare Chess Leaderboard">
	<BackgroundLines />
	<Header />
	<main id="main-content" class="leaderboard-page">
		<div class="page-heading">
			<p class="eyebrow">Leaderboard</p>
			<h1>Top rated players.</h1>
			<p>Players appear after 10 rated games. Bot games never move Elo.</p>
		</div>
		<Card class="leaderboard-card">
			<div class="tabs"><a class={sort === 'rating' ? 'active' : ''} href="/leaderboard">Top rated</a><a class={sort === 'games' ? 'active' : ''} href="/leaderboard?sort=games">Most active</a></div>
			{entries.length ? (
				<table>
					<thead><tr><th>#</th><th>Player</th><th>Rating</th><th>Peak</th><th>Games</th><th>Win %</th></tr></thead>
					<tbody>{entries.map((entry) => <tr><td>{entry.rank}</td><td><a href={`/p/${entry.playerId}`}>{entry.playerId}</a></td><td>{entry.rating}</td><td>{entry.peakRating}</td><td>{entry.games}</td><td>{entry.winRate}%</td></tr>)}</tbody>
				</table>
			) : <p class="empty">No ranked players yet. Play 10 rated games to enter the board.</p>}
		</Card>
	</main>
	<Footer />
</Layout>

<style>
	.leaderboard-page { max-width: var(--container-xl); margin: 0 auto; padding: 48px 16px 0; }
	.page-heading { max-width: 720px; margin-bottom: 28px; }
	.eyebrow { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--cf-orange); }
	h1 { margin: 0; font-size: clamp(40px, 7vw, 76px); line-height: .95; font-weight: 500; letter-spacing: -.055em; }
	.page-heading p:last-child, .empty { color: var(--cf-text-muted); line-height: 1.55; }
	:global(.leaderboard-card) { padding: 28px; }
	.tabs { display: flex; gap: 8px; margin-bottom: 16px; }
	.tabs a { padding: 8px 12px; border: 1px solid var(--cf-border); border-radius: 9999px; font-size: 14px; }
	.tabs a.active { background: var(--cf-orange); color: var(--cf-bg-100); border-color: var(--cf-orange); }
	table { width: 100%; border-collapse: collapse; font-size: 14px; }
	th, td { padding: 13px 8px; border-top: 1px solid var(--cf-border-light); text-align: left; }
	th { color: var(--cf-text-muted); font-weight: 500; }
	td:nth-child(3), td:nth-child(4), td:nth-child(5), td:nth-child(6) { font-family: var(--font-mono); }
	td a { color: var(--cf-orange); }
	@media (max-width: 680px) { table { font-size: 12px; } th:nth-child(4), td:nth-child(4), th:nth-child(6), td:nth-child(6) { display: none; } }
</style>
