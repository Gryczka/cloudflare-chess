---
import BackgroundLines from '../components/BackgroundLines.astro';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Log in to Cloudflare Chess">
	<BackgroundLines />
	<Header />
	<main id="main-content" class="login-page">
		<Card class="login-card">
			<p class="eyebrow">Return to your rating</p>
			<h1>Log in with your recovery key.</h1>
			<p class="muted">Paste the recovery key you saved when you first played, like <code>cfk_…</code>. Your handle (e.g. <code>tactical-knight-2048</code>) is public — the recovery key is the secret credential.</p>
			<form id="login-form">
				<label for="secret">Recovery key</label>
				<input id="secret" name="secret" placeholder="cfk_…" required autocomplete="off" spellcheck="false" />
				<button type="submit">Log in</button>
			</form>
			<p id="login-status" class="status"></p>
		</Card>
	</main>
	<Footer />
	<script is:inline>
		document.querySelector('#login-form')?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const form = event.currentTarget;
			const status = document.querySelector('#login-status');
			const secret = new FormData(form).get('secret')?.toString().trim();
			if (status) status.textContent = 'Checking recovery key...';
			const response = await fetch('/api/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ secret }),
			});
			if (!response.ok) {
				if (status) status.textContent = 'That recovery key did not match any account.';
				return;
			}
			location.href = '/me';
		});
	</script>
</Layout>

<style>
	.login-page { display: grid; place-items: center; min-height: calc(100vh - 180px); padding: 48px 16px 0; }
	:global(.login-card) { width: min(100%, 620px); padding: 42px; }
	.eyebrow { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--cf-orange); }
	h1 { margin: 0; font-size: clamp(38px, 7vw, 64px); line-height: .95; font-weight: 500; letter-spacing: -.05em; }
	.muted, .status { color: var(--cf-text-muted); line-height: 1.55; }
	code { font-family: var(--font-mono); color: var(--cf-orange); }
	form { display: grid; gap: 12px; margin-top: 24px; }
	label { font-weight: 500; }
	input { width: 100%; padding: 14px 16px; border: 1px solid var(--cf-border); border-radius: 10px; background: var(--cf-bg-100); color: var(--cf-text); outline: none; font-family: var(--font-mono); }
	input:focus { border-color: var(--cf-orange); box-shadow: 0 0 0 3px rgba(255, 72, 1, .1); }
	button { min-height: 44px; border: 0; border-radius: 9999px; background: var(--cf-orange); color: var(--cf-bg-100); font-weight: 500; cursor: pointer; }
</style>
